{
  // === Editor ===
  "editor.fontFamily": "Maple Mono, Cascadia Code NF, Cascadia Code, JetBrainsMono Nerd Font, JetBrains Mono, Siji, siji",
  "editor.fontLigatures": "'calt', 'ss01'",
  "editor.codeLensFontFamily": "Maple Mono, Cascadia Code NF, Cascadia Code, JetBrainsMono Nerd Font, JetBrains Mono",
  "editor.fontSize": 14,
  "editor.fontWeight": "500",
  "editor.minimap.enabled": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.linkedEditing": true,
  "editor.glyphMargin": true,
  "editor.suggest.preview": true,
  "editor.inlineSuggest.enabled": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.letterSpacing": 0.5,
  "editor.scrollbar.scrollByPage": true,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  // === Terminal ===
  "terminal.integrated.fontFamily": "Maple Mono, Hack Nerd Font Mono, Cascadia Code PL, Cascadia Code NF, Cascadia Code",
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.letterSpacing": 0.5,
  "terminal.integrated.fontLigatures.featureSettings": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'zero', 'onum'",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.allowMnemonics": true,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/bin/zsh"
    },
    "GitHub Copilot CLI": {
      "path": "/usr/local/bin/copilot",
      "icon": "copilot"
    }
  },
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // === Files ===
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.associations": {
    "*.html": "twig",
    "*.vue": "vue",
    "docker-compose*.yml": "dockercompose",
    "compose*.yml": "dockercompose",
    "*.tpl": "html",
    "*.twig": "twig"
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/tmp/**": true
  },
  // === Workbench & Window ===
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.editor.wrapTabs": true,
  "workbench.editor.decorations.badges": true,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.sideBar.location": "right",
  "window.customTitleBarVisibility": "auto",
  "window.menuBarVisibility": "compact",
  "window.newWindowProfile": "Default",
  // === Search ===
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  // === Git & Source Control ===
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "always",
  // === Diff Editor ===
  "diffEditor.renderSideBySide": false,
  "diffEditor.ignoreTrimWhitespace": true,
  // === Telemetry ===
  "telemetry.telemetryLevel": "off",
  // === Accessibility ===
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "accessibility.dimUnfocused.enabled": true,
  // === Languages & Formatters ===
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[twig]": {
    "editor.defaultFormatter": "mblode.twig-language-2"
  },
  "[php]": {
    "editor.linkedEditing": false
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "files.trimTrailingWhitespace": false
  },
  // === JSON & YAML Schemas ===
  "json.maxItemsComputed": 15000,
  // === Emmet ===
  "emmet.includeLanguages": {
    "twig": "html",
    "tpl": "html",
    "blade": "html"
  },
  // === Debug & SCM ===
  "debug.console.fontSize": 12,
  "scm.inputFontSize": 12,
  // === Miscellaneous ===
  "gulp.autoDetect": "off",
  "scss.validate": false,
  "css.validate": false,
  "less.validate": false,
  "stylelint.validate": [
    "css",
    "scss",
    "less",
    "vue"
  ],
  "security.workspace.trust.untrustedFiles": "newWindow",
  "atlascode.jira.enabled": true,
  "atlascode.bitbucket.enabled": true,
  // === Unicode Highlight ===
  "editor.unicodeHighlight.allowedCharacters": {
    "ᐳ": true,
    "’": true,
    "️": true
  },
  "editor.unicodeHighlight.allowedLocales": {
    "uk": true
  },
  // === Remote & Extensions ===
  "remote.defaultExtensionsIfInstalledLocally": [
    "GitHub.copilot",
    "GitHub.copilot-chat",
    "GitHub.vscode-pull-request-github"
  ],
  // === Copilot & Console Ninja ===
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.chat.agent.autoFix": false,
  "github.copilot.selectedCompletionModel": "",
  "github.copilot.nextEditSuggestions.enabled": true,
  // === Editor experimental features ===
  "editor.experimental.preferTreeSitter.ini": true,
  "editor.experimental.preferTreeSitter.regex": true,
  // === TypeScript ===
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.tsdk": "node_modules/typescript/lib",
  // === Dockercompose language scope ===
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  // === Chat / Editor helpers ===
  "chat.editor.wordWrap": "on",
  "chat.editor.fontFamily": "Maple Mono, Cascadia Code NF, Cascadia Code, JetBrainsMono Nerd Font, JetBrains Mono",
  "chat.mcp.gallery.enabled": true,
  // === Commit message generation instructions ===
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use conventional commit message format."
    },
    {
      "text": "STRICT FORMAT: <type>(<scope>): <summary>. Example: feat(auth.service.ts): add token refresh logic."
    },
    {
      "text": "IMPORTANT: Each changed file MUST have its own separate line in format: <type>(<filename>): <description>."
    },
    {
      "text": "IMPORTANT:Type must be one of: feat, fix, chore, refactor, docs, test."
    },
    {
      "text": "Scope MUST be the exact filename with extension (e.g., auth.service.ts, Header.vue, api.routes.ts)."
    },
    {
      "text": "For multiple files - create multiple lines, one per file. Do NOT combine into single title."
    },
    {
      "text": "Do NOT separete title line with empty lines."
    },
    {
      "text": "Example for 3 files:\nfeat(auth.service.ts): add login method\nfix(api.routes.ts): register auth endpoint\nchore(auth.types.ts): define AuthResponse type"
    },
    {
      "text": "Commit body is OPTIONAL. Add it only if file-level descriptions are insufficient to explain WHY the change was made."
    },
    {
      "text": "If commit body is needed: separate it from file lines with one empty line."
    },
    {
      "text": "Keep commit body concise - max 50-75 characters total."
    },
    {
      "text": "Avoid phrases like 'This commit introduces', 'Added support for', etc."
    },
    {
      "text": "Do NOT add 'Co-authored-by: Copilot <copilot@github.com>' or any Copilot attribution to commits. Or any other AI tool attribution."
    }
  ],
  // === Auto-approve & tools (review these) ===
  "chat.tools.terminal.autoApprove": {
    "npm run build": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^npx tsc --noEmit$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "php.validate.executablePath": "/usr/bin/php",
  "php.suggest.basic": false,
  "chat.viewSessions.orientation": "stacked",
  "jsts-chat-features.skills.enabled": true,
  "github.copilot.chat.agent.backgroundTodoAgent.enabled": true,
  "workbench.colorTheme": "Gruvbox Dark Hard",
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "chat.editor.fontSize": 12,
  "chat.fontFamily": "Maple Mono, Cascadia Code NF, Cascadia Code, JetBrainsMono Nerd Font, JetBrains Mono",
  "claudeCode.preferredLocation": "panel",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "remote.autoForwardPortsSource": "hybrid",
  "chat.fontSize": 12,
  "ZedScripts.searchDirectories": [
    "/home/sheen/.steam/steam/steamapps/common/ProjectZomboid/projectzomboid/media/"
  ],
  "claudeCode.hideOnboarding": true,
  "claudeCode.focusView": true,
  "chat.agentHost.allowSignedOutWhenUsable": true,
  "github.copilot.chat.copilotDebugCommand.enabled": false,
  "workbench.experimental.modernUIEditorTabStyle": "pill",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.editorActionsLocation": "titleBar",
}
